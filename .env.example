# Copy to .env (which git ignores) and replace the values. docker compose reads .env automatically.
# JWT signing secret: at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# Optional Database credentials (default: ticketing / ticketing)
DB_USERNAME=ticketing
DB_PASSWORD=ticketing
MYSQL_ROOT_PASSWORD=root-local-only
